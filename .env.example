# Brain University environment. Copy to .env (gitignored) or export in your shell.

# ── LLM backend ────────────────────────────────────────────────────────────
# Default: Anthropic Claude. Set ANTHROPIC_API_KEY to use it.
ANTHROPIC_API_KEY=sk-ant-...

# Local Gemma (GGUF) backend — runs lessons / quizzes / podcasts / debate on
# your own machine, no Claude cost. Serve the GGUF with Ollama, llama-cpp-python,
# or llama.cpp (see GEMMA_SETUP.md), then set:
LLM_BACKEND=local
LOCAL_LLM_BASE=http://localhost:11434/v1   # Ollama; llama-cpp-python uses :8000/v1
LOCAL_LLM_MODEL=gemma-coder                 # the name you registered the model under
# LOCAL_LLM_KEY=                            # only if your local server requires a bearer token
# With LLM_BACKEND=local set, generation tries the local model first and falls
# back to Anthropic ONLY if ANTHROPIC_API_KEY is also set. Unset LLM_BACKEND to
# go back to Claude.

# ── Optional premium TTS for podcast voices ────────────────────────────────
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ── Persistence ────────────────────────────────────────────────────────────
BRAIN_DB=data/brain_university.db
