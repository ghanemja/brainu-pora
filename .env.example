# Brain University environment. Copy to .env (gitignored) or export in your shell.
# Template only — NO real values belong in this file or anywhere in the repo.

# ── LLM backend ────────────────────────────────────────────────────────────
# Default: Anthropic Claude. Set ANTHROPIC_API_KEY to use it.
ANTHROPIC_API_KEY=sk-ant-...

# Local Gemma (GGUF) backend — runs lessons / quizzes / podcasts / debate on
# your own machine, no Claude cost. Serve the GGUF with Ollama, llama-cpp-python,
# or llama.cpp (see GEMMA_SETUP.md), then set:
LLM_BACKEND=local
LOCAL_LLM_BASE=http://localhost:11434/v1   # Ollama; llama-cpp-python uses :8000/v1
LOCAL_LLM_MODEL=gemma-coder                 # the name you registered the model under
LOCAL_LLM_KEY=                              # bearer token, only if your LLM server needs one (HF endpoints: hf_xxxxxxxx)
# With LLM_BACKEND=local set, generation tries the local model first and falls
# back to Anthropic ONLY if ANTHROPIC_API_KEY is also set. Unset LLM_BACKEND to
# go back to Claude.

# ── Hugging Face ───────────────────────────────────────────────────────────
HF_TOKEN=                # HF access token for HFEndpointBackend + deploy scripts (hf_xxxxxxxx)

# ── Auth (API login gate) ──────────────────────────────────────────────────
# REQUIRED when auth is enabled: the API refuses to start (RuntimeError) if
# BU_AUTH_PASSWORD or BU_AUTH_SECRET is unset — no defaults on the enabled path.
BU_AUTH_USER=            # login username
BU_AUTH_PASSWORD=        # login password  (generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))")
BU_AUTH_SECRET=          # HMAC token-signing key  (generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
BU_AUTH_TTL_HOURS=24     # token lifetime in hours (optional, default 24)
# BU_AUTH_DISABLED=1     # dev-only auth bypass used by scripts/demo_start.sh — NEVER set in production

# ── Identity & multi-tenancy (Phase 2 — api/identity.py, docs/TENANCY.md) ──
# Bootstrap local admin (org 'org-demo'): provisioned on first use when BOTH
# are set; setting only one is a startup RuntimeError. Leave both unset to
# keep the legacy single-admin login only.
BU_BOOTSTRAP_ADMIN_EMAIL=     # e.g. admin@example.com
BU_BOOTSTRAP_ADMIN_PASSWORD=  # generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))"

# OIDC SSO (authorization-code flow). ALL optional: leave OIDC_ISSUER unset
# to disable (/auth/oidc/* return 404). Once OIDC_ISSUER is set the other
# three are REQUIRED (startup RuntimeError if missing). First login joins the
# org whose orgs.domain matches the verified email domain (role: viewer).
OIDC_ISSUER=             # e.g. https://accounts.google.com or https://YOUR_TENANT.auth0.com/
OIDC_CLIENT_ID=          # client id registered with the IdP
OIDC_CLIENT_SECRET=      # client secret from the IdP
OIDC_REDIRECT_URL=       # must match the IdP-registered callback, e.g. https://api.example.com/auth/oidc/callback

# At-rest encryption key for T2 crown-jewel columns (Fernet; per-org subkeys
# derived via HKDF(org_id) — see docs/TENANCY.md data classes).
DATA_ENCRYPTION_KEY=     # generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Evidence signing (Phase 3 — atp/signing.py, atp/exams.py) ──────────────
# HMAC-SHA256 key for the tamper-evident atp_evidence chain. REQUIRED whenever
# an exam writes/verifies evidence and auth is enabled (fail-loud RuntimeError
# if unset). With BU_AUTH_DISABLED=1 dev mode falls back to a key derived from
# BU_AUTH_SECRET, or a process-ephemeral key with a loud warning (dev sigs
# then don't survive restarts). Rotating this key invalidates verification of
# previously signed evidence — export/re-anchor the chain before rotating.
EVIDENCE_SIGNING_KEY=    # generate: python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Optional premium TTS for podcast voices (feature no-ops when unset) ────
ELEVENLABS_API_KEY=      # ElevenLabs TTS
OPENAI_API_KEY=          # OpenAI TTS + Whisper voice input

# ── Optional integrations (feature no-ops when unset) ──────────────────────
SEMANTIC_SCHOLAR_API_KEY=   # higher Semantic Scholar rate limits
VOYAGE_API_KEY=             # Voyage embeddings for graphiti (graph/temporal_graph.py)
GOOGLE_API_KEY=             # Gemini LLM/embeddings for graphiti (alias: GEMINI_API_KEY)
GEMINI_API_KEY=             # alternative name for GOOGLE_API_KEY

# ── Persistence ────────────────────────────────────────────────────────────
BRAIN_DB=data/brain_university.db
DATABASE_URL=            # unset = SQLite at BRAIN_DB. Postgres (prod): postgresql+psycopg2://user:pass@host:5432/dbname (bare postgres:// URLs are normalized)
BU_DB_POOL_SIZE=5        # Postgres connection pool size per worker (max_overflow fixed at 5); ignored on SQLite
